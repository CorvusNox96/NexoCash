<Window x:Class="NexoCash.Desktop.Features.Accounts.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva cuenta" Width="450" Height="290" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#E1E8F0">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="FormTitle" Text="Nueva cuenta" FontSize="23" FontWeight="SemiBold" Foreground="#183345"/>
        <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="Nombre de la cuenta" Foreground="#456371"/><TextBox x:Name="NameBox" Height="30" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Row="2" Margin="0,13,0,0"><TextBlock Text="Tipo de cuenta" Foreground="#456371"/><ComboBox x:Name="TypePicker" Height="30" Margin="0,5,0,0" SelectedIndex="0"><ComboBoxItem Content="Efectivo"/><ComboBoxItem Content="Virtual"/></ComboBox></StackPanel>
        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#B44040" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Padding="15,8" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Guardar cuenta" Padding="15,8" Background="#2868C7" Foreground="White" BorderThickness="0" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>

