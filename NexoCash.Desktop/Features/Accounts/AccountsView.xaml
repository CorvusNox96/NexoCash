<UserControl x:Class="NexoCash.Desktop.Features.Accounts.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F8FAFD">
    <UserControl.Resources>
        <Style x:Key="RowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#183345"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DEEAFC"/><Setter Property="Foreground" Value="#183345"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="CellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#183345"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Background" Value="#DEEAFC"/><Setter Property="Foreground" Value="#183345"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="TextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableText}"/>
    </UserControl.Resources>
    <Grid Margin="28,25,28,27">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <StackPanel x:Name="HeaderActions" Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="EditButton" Content="Editar" IsEnabled="False" Click="Edit_Click" Padding="13,8" Margin="0,0,7,0"/>
                <Button x:Name="DeleteButton" Content="Eliminar" IsEnabled="False" Click="Delete_Click" Padding="13,8" Margin="0,0,7,0"/>
                <Button Content="+  Nueva cuenta" Background="#2868C7" Foreground="White" BorderThickness="0" Padding="14,8" Click="New_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Foreground="#7D929F" FontSize="12"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionUnit="FullRow" SelectionChanged="AccountsGrid_SelectionChanged" GridLinesVisibility="None"
                      RowHeaderWidth="0" RowStyle="{StaticResource RowStyle}" CellStyle="{StaticResource CellStyle}"
                      Background="#F8FAFD" BorderBrush="#9BB2CD" BorderThickness="1" RowHeight="53" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cuenta" Binding="{Binding Name}" ElementStyle="{StaticResource TextStyle}" Width="2*"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel, Converter={StaticResource SpanishDisplay}}" ElementStyle="{StaticResource TextStyle}" Width="100"/>
                    <DataGridTextColumn Header="Total en CUP" Binding="{Binding TotalCup}" ElementStyle="{StaticResource TableAmount}" HeaderStyle="{StaticResource TableAmountHeader}" Width="145"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="Aún no hay cuentas. Crea una para comenzar." Visibility="Collapsed"
                       Foreground="#718895" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

