<UserControl x:Class="NexoCash.Desktop.Features.Agencies.AgenciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NexoCash.Desktop.Shared.Converters"
             Background="#F8FAFD">
    <UserControl.Resources>
        <converters:PhotoBytesConverter x:Key="PhotoBytesConverter" />
        <converters:InitialLetterConverter x:Key="InitialLetterConverter" />
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#91ADD0" />
            <Setter Property="Background" Value="#E8EFFB" />
            <Setter Property="Foreground" Value="#254A80" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2868C7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FFF0EE" />
            <Setter Property="Foreground" Value="#A8443D" />
        </Style>
        <Style x:Key="AgencyHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDF3FC" />
            <Setter Property="Foreground" Value="#42628D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#B6CAE5" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="AgencyRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7F5" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DEEAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AgencyCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#183345" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#DEEAFC" />
                    <Setter Property="Foreground" Value="#183345" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AgencyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableText}"/>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0" Visibility="Collapsed">
            <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+  Nueva agencia" Style="{StaticResource PrimaryButton}" Click="New_Click" />
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="AgenciesGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="None" RowHeaderWidth="0"
                  RowStyle="{StaticResource AgencyRowStyle}" CellStyle="{StaticResource AgencyCellStyle}"
                  MouseDoubleClick="AgenciesGrid_DoubleClick"
                  Background="#F8FAFD" RowBackground="#F8FAFD" AlternatingRowBackground="#F8FAFD"
                  BorderBrush="#8FB1DB" BorderThickness="1"
                  ColumnHeaderStyle="{StaticResource AgencyHeaderStyle}"
                  ColumnHeaderHeight="40" RowHeight="60" FontSize="13">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="58" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="38" Height="38" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse Fill="#DDECEB" />
                                <TextBlock Text="{Binding Agency.Name, Converter={StaticResource InitialLetterConverter}}"
                                           Foreground="#246A65" FontWeight="Bold" FontSize="17"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Agency.Photo}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Agency.Photo, Converter={StaticResource PhotoBytesConverter}}"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Agency.Name}" ElementStyle="{StaticResource AgencyTextStyle}" Width="*" />
                <DataGridTextColumn Header="Administración" Binding="{Binding Agency.AdministrationNumber}" ElementStyle="{StaticResource AgencyTextStyle}" Width="150" />
                <DataGridTextColumn Header="Fondo en CUP" Binding="{Binding CupFund, StringFormat=N2}" ElementStyle="{StaticResource TableAmount}" HeaderStyle="{StaticResource TableAmountHeader}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

