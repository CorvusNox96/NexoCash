<Window x:Class="NexoCash.Desktop.Features.Agencies.AgencyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva agencia" Width="450" Height="660" MinWidth="400" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#E1E8F0" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#39566A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#C9D8E1" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#B02B35" TextWrapping="Wrap" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="16,9" Click="Cancel_Click" />
                <Button Content="Guardar" Padding="18,9" Margin="10,0,0,0"
                        Background="#2868C7" Foreground="White" BorderThickness="0" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="FormTitle" Text="Nueva agencia" Foreground="#183345" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Nombre *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" MaxLength="120" />
                <TextBlock Text="Número de administración" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NumberBox" Style="{StaticResource FieldBox}" MaxLength="50" />
                <TextBlock Text="Comisión por servicio (%)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PercentageBox" Style="{StaticResource FieldBox}" Text="0" />
                <TextBlock Text="Foto" Style="{StaticResource FieldLabel}" />
                <Border Height="115" Background="#F8FAFD" BorderBrush="#9BB2CD" BorderThickness="1" CornerRadius="6">
                    <Image x:Name="PhotoPreview" Stretch="Uniform" Margin="5" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Elegir foto" Padding="9,5" Click="ChoosePhoto_Click" />
                    <Button Content="Quitar" Padding="9,5" Margin="8,0,0,0" Click="RemovePhoto_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

