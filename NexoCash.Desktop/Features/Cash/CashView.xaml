<UserControl x:Class="NexoCash.Desktop.Features.Cash.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="BanknoteEquation">
            <Border Margin="0,0,10,10" Padding="12,9" Background="#F1F6FB"
                    BorderBrush="#8FB1DB" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ValueText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#183345"/>
                    <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#607987"/>
                    <TextBox Grid.Column="2" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" TextAlignment="Center" FontWeight="SemiBold"
                             BorderBrush="#8FB1DB" BorderThickness="1" Background="#F8FAFD"/>
                    <TextBlock Grid.Column="3" Text="=" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#607987"/>
                    <TextBlock Grid.Column="4" Text="{Binding AmountText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#2868C7"/>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="CashTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#42628D"/>
            <Setter Property="Background" Value="#DCE9F7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="#91ADD0" BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2868C7"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#2868C7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ItemsControl x:Name="ComparisonCards" Grid.Row="1" Margin="0,0,0,18">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1"
                            CornerRadius="8" Padding="18,14" Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F0F8"/>
                                <Setter Property="BorderBrush" Value="#8FB1DB"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Matches}" Value="False">
                                        <Setter Property="Background" Value="#FFF1F1"/>
                                        <Setter Property="BorderBrush" Value="#C96565"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Currency}" FontWeight="SemiBold" FontSize="14" Foreground="#183345" Margin="0,0,0,5"/>
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock Text="{Binding BalanceText}" DockPanel.Dock="Right" Foreground="#183345" FontWeight="SemiBold"/>
                                <TextBlock Text="Saldo de caja" Foreground="#607987" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock Text="{Binding BanknotesText}" DockPanel.Dock="Right" Foreground="#183345" FontWeight="SemiBold"/>
                                <TextBlock Text="Billetes registrados" Foreground="#607987" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding DifferenceText}" HorizontalAlignment="Right" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B44040"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Matches}" Value="True">
                                                <Setter Property="Foreground" Value="#168267"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CurrencySections"/>
        </ScrollViewer>
    </Grid>
</UserControl>
