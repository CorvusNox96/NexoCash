<UserControl x:Class="NexoCash.Desktop.Features.Exchange.ExchangeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#F8FAFD" BorderBrush="#8FB1DB" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14"><StackPanel>
            <WrapPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Cuenta"/><ComboBox x:Name="FromAccount" Width="175" DisplayMemberPath="Label" SelectionChanged="Account_Changed"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Moneda entregada"/><ComboBox x:Name="FromCurrency" Width="100" SelectionChanged="Currency_Changed"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Importe"/><TextBox x:Name="OutgoingAmount" Width="100" TextChanged="Amount_Changed"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock x:Name="RateLabel" Text="Tasa real"/><TextBox x:Name="RateBox" Width="100" TextChanged="Amount_Changed"/></StackPanel></WrapPanel>
            <WrapPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Moneda recibida"/><ComboBox x:Name="ToCurrency" Width="100" SelectionChanged="Currency_Changed"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Descripción"/><TextBox x:Name="DescriptionBox" Width="280"/></StackPanel></WrapPanel>
            <TextBlock x:Name="ReceivedPreview" Foreground="#456371" Margin="0,0,0,8"/>
            <WrapPanel x:Name="HeaderActions" Margin="0,5,0,0"><Button x:Name="CountOutgoing" Content="Contar efectivo entregado" Margin="0,0,8,0" Click="CountOutgoing_Click"/><Button x:Name="CountIncoming" Content="Contar efectivo recibido" Margin="0,0,8,0" Click="CountIncoming_Click"/><Button Content="Guardar cambio" Background="#2868C7" Foreground="White" BorderThickness="0" Click="Save_Click"/></WrapPanel>
            <TextBlock x:Name="CountSummary" Foreground="#607987" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <DataGrid Grid.Row="1" x:Name="ExchangesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.GroupStyle><StaticResource ResourceKey="DateHistoryGroup"/></DataGrid.GroupStyle><DataGrid.Columns><DataGridTextColumn Header="Hora" Binding="{Binding TimeText}" ElementStyle="{StaticResource TableText}" Width="90"/><DataGridTextColumn Header="Cuenta" Binding="{Binding AccountText}" ElementStyle="{StaticResource TableText}" Width="*"/><DataGridTextColumn Header="Entregado" Binding="{Binding OutText}" ElementStyle="{StaticResource TableAmount}" HeaderStyle="{StaticResource TableAmountHeader}" Width="150"/><DataGridTextColumn Header="Recibido" Binding="{Binding InText}" ElementStyle="{StaticResource TableAmount}" HeaderStyle="{StaticResource TableAmountHeader}" Width="150"/><DataGridTextColumn Header="Tasa" Binding="{Binding RateText}" ElementStyle="{StaticResource TableAmount}" HeaderStyle="{StaticResource TableAmountHeader}" Width="105"/></DataGrid.Columns></DataGrid>
    </Grid>
</UserControl>
