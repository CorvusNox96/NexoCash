<Window x:Class="NexoCash.Desktop.Features.Movements.MovementEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimiento de dinero" Width="530" Height="550" MinWidth="490" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#E1E8F0">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="#183345"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#91ADD0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#3478D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#183345"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#91ADD0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="PickerBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
                            <ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <ToggleButton ClickMode="Press" Focusable="False" Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#42628D" StrokeThickness="1.6"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#F8FAFD" BorderBrush="#91ADD0" BorderThickness="1"
                                        CornerRadius="8" Padding="4" MaxHeight="260"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#3478D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="FormTitle" FontSize="24" FontWeight="SemiBold" Foreground="#183345"/>
        <TextBlock x:Name="HelpText" Grid.Row="1" Foreground="#607987" TextWrapping="Wrap" Margin="0,5,0,17"/>
        <Border Grid.Row="2" Grid.RowSpan="5" Margin="-15,-11,-15,-8" Background="#F8FAFD"
                BorderBrush="#9BB2CD" BorderThickness="1" CornerRadius="12"/>
        <StackPanel Grid.Row="2"><TextBlock x:Name="SourceLabel" Text="Cuenta" Foreground="#456371"/><ComboBox x:Name="SourcePicker" DisplayMemberPath="Label" Height="31" Margin="0,5,0,0" SelectionChanged="Account_Changed"/></StackPanel>
        <StackPanel x:Name="DestinationPanel" Grid.Row="3" Margin="0,13,0,0"><TextBlock Text="Cuenta de destino" Foreground="#456371"/><ComboBox x:Name="DestinationPicker" DisplayMemberPath="Label" Height="31" Margin="0,5,0,0" SelectionChanged="Account_Changed"/></StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,15,0,0">
            <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="Moneda" Foreground="#456371"/><ComboBox x:Name="CurrencyPicker" Height="31" Margin="0,5,0,0" SelectionChanged="Currency_Changed"/></StackPanel>
            <StackPanel Width="175"><TextBlock Text="Importe" Foreground="#456371"/><TextBox x:Name="AmountBox" Height="31" Margin="0,5,0,0" TextChanged="Amount_Changed"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,15,0,0"><TextBlock Text="Descripción (opcional)" Foreground="#456371"/><TextBox x:Name="DescriptionBox" Height="31" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Row="6" Margin="0,15,0,0">
            <StackPanel x:Name="BanknotesPanel"><TextBlock x:Name="BanknotesLabel" Text="Billetes (opcional para ingresos y retiros)" Foreground="#456371"/><Button Content="Contar billetes..." HorizontalAlignment="Left" Padding="13,7" Margin="0,6,0,0" Click="CountBanknotes_Click"/><TextBlock x:Name="CountSummaryText" Foreground="#607987" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#B44040" TextWrapping="Wrap" Margin="0,13,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancelar" Padding="15,8" Margin="0,0,8,0" Click="Cancel_Click"/><Button x:Name="SaveButton" Background="#2868C7" Foreground="White" BorderThickness="0" Padding="16,8" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>

