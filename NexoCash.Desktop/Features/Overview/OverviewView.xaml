<UserControl x:Class="NexoCash.Desktop.Features.Overview.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#8FB1DB"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="17,14"/><Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#42628D"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#183345"/><Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,10">
            <UniformGrid Columns="3">
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="EFECTIVO EN CUENTAS" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CashText" Style="{StaticResource MetricValue}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="SALDOS POR MONEDA" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="BalanceText" Style="{StaticResource MetricValue}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="SERVICIOS SIN CONSOLIDAR" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="ServicesText" Style="{StaticResource MetricValue}"/><TextBlock x:Name="PendingAmountText" Foreground="#607987" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="LISTOS PARA CONSOLIDAR" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="ReadyText" Style="{StaticResource MetricValue}"/><TextBlock x:Name="ReadyAmountText" Foreground="#607987" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="INGRESOS DE LA SEMANA" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CurrentWeekText" Style="{StaticResource MetricValue}"/><TextBlock x:Name="CurrentWeekCountText" Foreground="#607987" FontSize="11"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="MEJOR SEMANA" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="BestWeekText" Style="{StaticResource MetricValue}"/><TextBlock x:Name="BestWeekDateText" Foreground="#607987" FontSize="11"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="EQUIVALENTE ESTIMADO" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="EquivalentText" Style="{StaticResource MetricValue}" TextWrapping="Wrap"/><TextBlock x:Name="EquivalentHint" Foreground="#607987" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="FONDO PARA RENTA" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="RentFundText" Style="{StaticResource MetricValue}"/><TextBlock x:Name="RentMissingText" Foreground="#607987" FontSize="12"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="FONDOS DE AGENCIAS" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="AgencyFundsCardText" Style="{StaticResource MetricValue}"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Text="INGRESOS POR SERVICIOS · ÚLTIMAS 8 SEMANAS" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="PeriodIncomeText" Style="{StaticResource MetricValue}"/><TextBlock x:Name="PeriodServicesText" Foreground="#607987" FontSize="11"/></StackPanel>
            </Border>
            <Grid Margin="0,10,12,12"><TextBlock Text="Ingresos semanales por servicios" FontSize="17" FontWeight="SemiBold" Foreground="#183345" VerticalAlignment="Center"/><ComboBox x:Name="ChartCurrency" Width="110" Height="34" HorizontalAlignment="Right" SelectionChanged="ChartCurrency_SelectionChanged"/></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,12"><StackPanel><TextBlock Text="COMPARACIÓN SEMANAL" Style="{StaticResource MetricLabel}"/><ItemsControl x:Name="BarChart" Margin="4,15,4,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border VerticalAlignment="Bottom" Height="{Binding BarHeight}" Background="#3C78CF" CornerRadius="5,5,0,0" ToolTip="{Binding Tooltip}"/><TextBlock Grid.Row="1" Text="{Binding WeekLabel}" HorizontalAlignment="Center" Foreground="#42628D" FontSize="10" Margin="0,7,0,0"/><TextBlock Grid.Row="2" Text="{Binding AmountLabel}" HorizontalAlignment="Center" Foreground="#183345" FontSize="10" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="0,0,0,12"><StackPanel><TextBlock Text="TENDENCIA SEMANAL" Style="{StaticResource MetricLabel}"/><Viewbox Height="170" Stretch="Fill" Margin="5,15,5,0"><Canvas Width="560" Height="160"><Line X1="0" Y1="145" X2="560" Y2="145" Stroke="#C9D9EC" StrokeThickness="1"/><Line X1="0" Y1="75" X2="560" Y2="75" Stroke="#E4EDF8" StrokeThickness="1"/><Path x:Name="TrendPath" Stroke="#2868C7" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock x:Name="TrendText" Foreground="#607987" FontSize="11" Margin="5,8,0,0"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,12,12"><StackPanel><TextBlock Text="CUENTA PERSONAL · INGRESOS VS RETIROS" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="PersonalFlowTotalText" Foreground="#607987" Margin="0,5,0,0"/><ItemsControl x:Name="PersonalFlowChart" Margin="4,12,4,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="5,0"><Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center"><Border Width="18" Height="{Binding IncomeHeight}" Background="#2B9A83" CornerRadius="4,4,0,0" Margin="0,0,3,0" ToolTip="{Binding IncomeTooltip}"/><Border Width="18" Height="{Binding WithdrawalHeight}" Background="#C87968" CornerRadius="4,4,0,0" ToolTip="{Binding WithdrawalTooltip}"/></StackPanel><TextBlock Grid.Row="1" Text="{Binding WeekLabel}" HorizontalAlignment="Center" Foreground="#42628D" FontSize="10" Margin="0,6,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0"><TextBlock Text="■ Ingresos" Foreground="#2B9A83" Margin="0,0,18,0"/><TextBlock Text="■ Retiros" Foreground="#C87968"/></StackPanel></StackPanel></Border>
            <TextBlock Text="Saldos por moneda" FontSize="17" FontWeight="SemiBold" Foreground="#183345" Margin="0,10,0,12"/>
            <ItemsControl x:Name="CurrencyCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{Binding Currency}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding TotalText}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding CashText}" Foreground="#607987" Margin="0,8,0,7"/><ProgressBar Height="7" Maximum="100" Value="{Binding Share}" Foreground="#2868C7" Background="#D5E2F2"/><TextBlock Text="{Binding ShareText}" Foreground="#607987" HorizontalAlignment="Right" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
