<Window x:Class="NexoCash.Desktop.Features.Services.ServiceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Nuevo servicio" Width="620" Height="560" MinWidth="620" MinHeight="480"
        MaxWidth="620" MaxHeight="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#E1E8F0" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#42628D"/><Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="TextStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="BorderBrush" Value="#8FB1DB"/>
            <Setter Property="Background" Value="#F8FAFD"/>
        </Style>
        <Style x:Key="DateTextStyle" TargetType="TextBox" BasedOn="{StaticResource TextStyle}">
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#174A94"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="#8FB1DB"
                        BorderThickness="1" CornerRadius="7">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="BorderBrush" Value="#8FB1DB"/>
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="Foreground" Value="#183345"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="EditorTitle" Text="Nuevo servicio" FontSize="22" FontWeight="SemiBold" Foreground="#183345"/>
            <TextBlock x:Name="EditorSubtitle" Text="Registra los datos principales del servicio." Foreground="#607987" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#F8FAFD" BorderBrush="#8FB1DB" BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Fecha del servicio *" Style="{StaticResource LabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="DatePicker" Visibility="Collapsed" SelectedDateChanged="DatePicker_Changed"/>
                            <TextBox x:Name="DateText" Width="220" Style="{StaticResource DateTextStyle}"
                                     LostFocus="DateText_LostFocus" KeyDown="DateText_KeyDown"/>
                            <Button x:Name="CalendarButton" Width="36" Height="36" Padding="8" Margin="6,0,0,0"
                                    Background="Transparent" BorderBrush="#8FB1DB" Click="CalendarButton_Click">
                                <icons:PackIconLucide Kind="CalendarDays" Width="17" Height="17" Foreground="#174A94"/>
                            </Button>
                            <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=CalendarButton}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="#F8FAFD" BorderBrush="#8FB1DB" BorderThickness="1" CornerRadius="8" Padding="6">
                                    <Calendar x:Name="DateCalendar" SelectedDatesChanged="DateCalendar_Changed"/>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Modalidad *" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="TypeCombo" Style="{StaticResource ComboStyle}" DisplayMemberPath="Label"
                                  SelectionChanged="TypeCombo_SelectionChanged"/></StackPanel>
                </Grid>
                <Grid x:Name="AgencyPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Agencia *" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="AgencyCombo" Style="{StaticResource ComboStyle}" DisplayMemberPath="Label"
                                  SelectionChanged="AgencyCombo_SelectionChanged"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Comisión aplicada (%) *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="CommissionBox" Style="{StaticResource TextStyle}"/></StackPanel>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Importe *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="AmountBox" Style="{StaticResource TextStyle}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Moneda *" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="CurrencyCombo" Style="{StaticResource ComboStyle}"/></StackPanel>
                </Grid>
                <TextBlock Text="Forma de cobro *" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="PaymentCombo" Style="{StaticResource ComboStyle}" DisplayMemberPath="Label"/>
                <TextBlock x:Name="StatusHint" Foreground="#607987" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="El servicio se registra como abierto."/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#B44040" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="340"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancelar" Padding="14,7" Click="Cancel_Click"/>
                <Button x:Name="DeleteButton" Content="Eliminar" Visibility="Collapsed" Padding="14,7" Margin="10,0,0,0" Click="Delete_Click"/>
                <Button x:Name="FinishButton" Content="Finalizar" Visibility="Collapsed" Padding="14,7" Margin="10,0,0,0" Click="Finish_Click"/>
                <Button x:Name="SaveButton" Content="Guardar servicio" Padding="16,7" Margin="10,0,0,0"
                        Background="#2868C7" Foreground="White" BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
