<UserControl x:Class="NexoCash.Desktop.Features.Services.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="HistoryDateBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#174A94"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border BorderBrush="#91ADD0" BorderThickness="1" CornerRadius="7" Background="{TemplateBinding Background}">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2868C7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="#F8FAFD" />
            <Setter Property="Foreground" Value="#183345" />
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#8FB1DB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DEEAFC" />
                    <Setter Property="Foreground" Value="#183345" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#183345" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#DEEAFC" />
                    <Setter Property="Foreground" Value="#183345" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ServiceTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#183345" />
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="12,0,8,0"/>
        </Style>
        <Style x:Key="ServiceAmountStyle" TargetType="TextBlock" BasedOn="{StaticResource ServiceTextStyle}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="12,0,104,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="ServiceAmountHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDF3FC"/>
            <Setter Property="Foreground" Value="#42628D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,12,104,12"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0" Visibility="Collapsed">
            <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Consolidar" Padding="12,6" Margin="0,0,10,0" Click="Consolidate_Click" />
                <Button Content="+  Nuevo servicio" Style="{StaticResource PrimaryButton}"
                        Click="New_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Text="0 servicios registrados" Foreground="#7D929F" FontSize="12" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel x:Name="HistoryFilters" Grid.Row="0" Orientation="Horizontal" Visibility="Collapsed"
                        Margin="0,0,18,0" VerticalAlignment="Center">
                <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#42628D" FontWeight="SemiBold"/>
                <DatePicker x:Name="HistoryFrom" Visibility="Collapsed" SelectedDateChanged="HistoryDate_Changed"/>
                <TextBox x:Name="HistoryFromText" Width="100" Height="32" Style="{StaticResource HistoryDateBox}" LostFocus="HistoryText_LostFocus"/>
                <Button x:Name="HistoryFromCalendarButton" Width="32" Height="32" Margin="4,0,0,0" Padding="6" Background="Transparent" BorderBrush="#91ADD0" Click="HistoryCalendar_Click">
                    <icons:PackIconLucide Kind="CalendarDays" Width="16" Height="16" Foreground="#174A94"/>
                </Button>
                <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="#42628D" FontWeight="SemiBold"/>
                <DatePicker x:Name="HistoryTo" Visibility="Collapsed" SelectedDateChanged="HistoryDate_Changed"/>
                <TextBox x:Name="HistoryToText" Width="100" Height="32" Style="{StaticResource HistoryDateBox}" LostFocus="HistoryText_LostFocus"/>
                <Button x:Name="HistoryToCalendarButton" Width="32" Height="32" Margin="4,0,0,0" Padding="6" Background="Transparent" BorderBrush="#91ADD0" Click="HistoryCalendar_Click">
                    <icons:PackIconLucide Kind="CalendarDays" Width="16" Height="16" Foreground="#174A94"/>
                </Button>
                <Popup x:Name="HistoryCalendarPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                    <Border Background="#F8FAFD" BorderBrush="#91ADD0" BorderThickness="1" CornerRadius="8" Padding="6">
                        <Calendar x:Name="HistoryCalendar" SelectedDatesChanged="HistoryCalendar_SelectedDatesChanged"/>
                    </Border>
                </Popup>
            </StackPanel>
            <TabControl x:Name="ServiceTabs" SelectionChanged="ServiceTabs_SelectionChanged" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" Background="Transparent"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#42628D"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabSurface" Background="#E1E8F0" BorderBrush="#8FB1DB"
                                            BorderThickness="1" CornerRadius="10,10,0,0" Padding="18,9" Margin="0,0,-1,0">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabSurface" Property="Background" Value="#F8FAFD"/>
                                            <Setter TargetName="TabSurface" Property="BorderThickness" Value="1,1,1,0"/>
                                            <Setter TargetName="TabSurface" Property="Margin" Value="0,0,-1,-1"/>
                                            <Setter TargetName="TabSurface" Property="Padding" Value="18,9,18,9"/>
                                            <Setter Property="Foreground" Value="#174A94"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabItem Header="Pendientes"/>
                <TabItem Header="Historial"/>
            </TabControl>
            <DataGrid Grid.Row="1" x:Name="ServicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" SelectionUnit="FullRow"
                      SelectionMode="Single" MouseDoubleClick="ServicesGrid_MouseDoubleClick"
                      GridLinesVisibility="None" RowHeaderWidth="0" RowStyle="{StaticResource RowStyle}"
                      CellStyle="{StaticResource CellStyle}" Background="Transparent" RowBackground="#F8FAFD"
                      BorderBrush="#9BB2CD" BorderThickness="0" RowHeight="58" FontSize="13">
                <DataGrid.GroupStyle><StaticResource ResourceKey="DateHistoryGroup"/></DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="DateColumn" Header="Fecha" Binding="{Binding DateText}" ElementStyle="{StaticResource ServiceTextStyle}" Width="*" />
                    <DataGridTextColumn Header="Referencia" Binding="{Binding Recipient}" ElementStyle="{StaticResource ServiceTextStyle}" Width="*" />
                    <DataGridTextColumn Header="Modalidad" Binding="{Binding Type, Converter={StaticResource SpanishDisplay}}" ElementStyle="{StaticResource ServiceTextStyle}" Width="*" />
                    <DataGridTextColumn Header="Importe" Binding="{Binding AmountText}" Width="*"
                                        ElementStyle="{StaticResource ServiceAmountStyle}"
                                        HeaderStyle="{StaticResource ServiceAmountHeader}"/>
                    <DataGridTextColumn Header="Cobro" Binding="{Binding PaymentMethod, Converter={StaticResource SpanishDisplay}}" ElementStyle="{StaticResource ServiceTextStyle}" Width="*" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding Status, Converter={StaticResource SpanishDisplay}}" ElementStyle="{StaticResource ServiceTextStyle}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" x:Name="EmptyText" Text="Aún no hay servicios registrados."
                       Foreground="#718895" FontSize="14" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>

