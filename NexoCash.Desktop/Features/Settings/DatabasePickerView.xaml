<UserControl x:Class="NexoCash.Desktop.Features.Settings.DatabasePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="22" MaxWidth="660" HorizontalAlignment="Left">
        <TextBlock Text="Crea una base nueva o elige un archivo de NexoCash de esta computadora. Cada base conserva su propia fecha de inicio."
                   Foreground="#607987" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <WrapPanel Margin="0,0,0,14">
            <Button Content="Crear nueva..." Padding="13,8" Margin="0,0,9,0" Click="Create_Click"/>
            <Button Content="Elegir archivo..." Padding="13,8" Click="Open_Click"/>
        </WrapPanel>
        <TextBlock Text="ARCHIVO SELECCIONADO" Foreground="#607987" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock x:Name="PathText" Text="Ninguno" Foreground="#183345" TextWrapping="Wrap"
                   Margin="0,5,0,17"/>
        <TextBlock Text="FECHA DE INICIO" Foreground="#607987" FontSize="11" FontWeight="SemiBold"/>
        <DatePicker x:Name="StartDatePicker" Width="150" HorizontalAlignment="Left" Margin="0,6,0,0"/>
        <TextBlock x:Name="DateHintText" Foreground="#607987" FontSize="12" TextWrapping="Wrap"
                   Margin="0,7,0,18"/>
        <Button Content="Usar esta base de datos" Background="#2868C7" Foreground="White"
                Padding="15,9" HorizontalAlignment="Left" Click="Activate_Click"/>
        <TextBlock x:Name="ErrorText" Foreground="#B44040" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
