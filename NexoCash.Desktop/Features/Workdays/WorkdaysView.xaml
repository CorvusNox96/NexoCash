<UserControl x:Class="NexoCash.Desktop.Features.Workdays.WorkdaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#EAF2FC"/>
            <Setter Property="BorderBrush" Value="#91ADD0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#607987"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardAmount" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#183345"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="WeekButtonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WeekArrow" TargetType="Button" BasedOn="{StaticResource WeekButtonBase}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#91ADD0"/>
            <Setter Property="Foreground" Value="#174A94"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="WeekToday" TargetType="Button" BasedOn="{StaticResource WeekButtonBase}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#91ADD0"/>
            <Setter Property="Foreground" Value="#174A94"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="WeekDateBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#174A94"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="BorderBrush" Value="#91ADD0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="DateBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DateBorder" Property="BorderBrush" Value="#2868C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="WeekSelectorPanel" Grid.Row="0" Grid.ColumnSpan="3" Background="#F8FAFD" BorderBrush="#9BB2CD"
                BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,16">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Semana de trabajo" FontSize="16" FontWeight="SemiBold" Foreground="#183345"/>
                <TextBlock Text="Elige una fecha" FontSize="12" Foreground="#607987" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PreviousWeekButton" ToolTip="Semana anterior" Style="{StaticResource WeekArrow}" Click="PreviousWeek_Click">
                    <icons:PackIconLucide Kind="ArrowLeft" Width="16" Height="16" Foreground="#174A94" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <DatePicker x:Name="WeekPicker" Visibility="Collapsed" SelectedDateChanged="WeekChanged"/>
                <TextBox x:Name="WeekDateText" Width="104" Height="30" Margin="5,0,0,0"
                         Style="{StaticResource WeekDateBox}" LostFocus="WeekDate_LostFocus" KeyDown="WeekDate_KeyDown"/>
                <Button x:Name="CalendarButton" ToolTip="Elegir fecha" Style="{StaticResource WeekArrow}"
                        Width="30" Margin="4,0,5,0" Click="CalendarButton_Click">
                    <icons:PackIconLucide Kind="CalendarDays" Width="16" Height="16" Foreground="#174A94" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Popup x:Name="WeekCalendarPopup" PlacementTarget="{Binding ElementName=CalendarButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#F8FAFD" BorderBrush="#91ADD0" BorderThickness="1" CornerRadius="8" Padding="6">
                        <Calendar x:Name="WeekCalendar" SelectedDatesChanged="WeekCalendar_SelectedDatesChanged"/>
                    </Border>
                </Popup>
                <Button ToolTip="Semana siguiente" Style="{StaticResource WeekArrow}" Click="NextWeek_Click">
                    <icons:PackIconLucide Kind="ArrowRight" Width="16" Height="16" Foreground="#174A94" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Content="Esta semana" Style="{StaticResource WeekToday}" Margin="8,0,0,0" Click="CurrentWeek_Click"/>
            </StackPanel>
        </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Monto semanal" Style="{StaticResource CardLabel}"/>
                <TextBlock x:Name="WeeklyTotalText" Text="54 000,00 CUP" Style="{StaticResource CardAmount}"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Background="#EEF6F7" BorderBrush="#91ADD0" Margin="4,0,4,0">
            <StackPanel>
                <TextBlock Text="Fondo en cuenta" Style="{StaticResource CardLabel}"/>
                <TextBlock x:Name="RentBalanceText" Style="{StaticResource CardAmount}"/>
                <TextBlock x:Name="RentAccountText" Foreground="#607987" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Border x:Name="DifferenceCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
            <StackPanel>
                <TextBlock x:Name="DifferenceLabel" Style="{StaticResource CardLabel}"/>
                <TextBlock x:Name="DifferenceText" Style="{StaticResource CardAmount}"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#F8FAFD" BorderBrush="#9BB2CD"
                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="WeekStatusText" Grid.Row="0" Visibility="Collapsed" Foreground="#607987" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="WeekRangeText" Visibility="Collapsed"/>
                <Grid Grid.Row="1" Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="115"/><ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FECHA" Style="{StaticResource CardLabel}"/>
                    <TextBlock Grid.Column="1" Text="COBERTURA" Style="{StaticResource CardLabel}"/>
                    <TextBlock Grid.Column="2" Text="SALDO" Style="{StaticResource CardLabel}"/>
                    <TextBlock Grid.Column="3" Text="LABORADO" Style="{StaticResource CardLabel}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="NO LABORADO" Style="{StaticResource CardLabel}" HorizontalAlignment="Center"/>
                </Grid>
                <ScrollViewer x:Name="DaysScroller" Grid.Row="2" Margin="0,7,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="DaysList" MinHeight="{Binding ActualHeight, ElementName=DaysScroller}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="7"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#9BB2CD" BorderThickness="0,0,0,1" Padding="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#183345"/>
                                        <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="#607987"/>
                                        <TextBlock Text="{Binding StateHint}" FontSize="10" Foreground="#607987"/>
                                    </StackPanel>
                                    <CheckBox x:Name="WorkedCheck" Grid.Column="3" ToolTip="Trabajó" IsEnabled="{Binding IsEditable}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsWorkedChecked, Mode=OneTime}"
                                              Checked="DayStatus_Changed" Unchecked="DayStatus_Changed"/>
                                    <CheckBox x:Name="NoWorkCheck" Grid.Column="4" ToolTip="No trabajó" IsEnabled="{Binding IsEditable}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsNoWorkChecked, Mode=OneTime}"
                                              Checked="DayStatus_Changed" Unchecked="DayStatus_Changed"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FundText}" VerticalAlignment="Center" Foreground="#183345" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MissingText}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#B44E42"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCovered}" Value="True"><Setter Property="Foreground" Value="#16815E"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNotApplicable}" Value="True"><Setter Property="Foreground" Value="#8799A5"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Margin="0">
                    <TextBlock x:Name="SelectionSummaryText" Visibility="Collapsed"/>
                    <Button x:Name="ConsolidateButton" Content="Consolidar" Padding="12,5"
                            HorizontalAlignment="Left" Background="Transparent" BorderBrush="#91ADD0"
                            Foreground="#174A94" Click="Consolidate_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
