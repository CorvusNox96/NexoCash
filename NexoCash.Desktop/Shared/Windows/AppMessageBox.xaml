<Window x:Class="NexoCash.Desktop.Shared.Windows.AppMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" MinWidth="380" MaxWidth="640" SizeToContent="Height"
        MaxHeight="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#E1E8F0">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" Foreground="#183345"
                   TextWrapping="Wrap" Margin="0,0,0,17"/>
        <Border Grid.Row="1" Background="#F8FAFD" BorderBrush="#9BB2CD" BorderThickness="1"
                CornerRadius="10" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330">
                <TextBlock x:Name="MessageText" FontSize="14" Foreground="#456371" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <StackPanel x:Name="ButtonsPanel" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </Grid>
</Window>
