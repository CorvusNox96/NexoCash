<Window x:Class="NexoCash.Desktop.Shared.Windows.BanknoteCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contar billetes" Width="1000" Height="650" MinWidth="960" MinHeight="630"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#E1E8F0">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E9EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07" Color="#36515C"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2868C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#174A94"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E7EEF0"/>
            <Setter Property="Foreground" Value="#294657"/>
        </Style>
        <Style x:Key="QuantityBox" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#183345"/>
            <Setter Property="BorderBrush" Value="#91ADD0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style x:Key="CurrencyTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#607987"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="#EDF3F4" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#E2EDFF"/><Setter Property="Foreground" Value="#174A94"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#DCE8FA"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><TextBlock Text="Contar billetes" FontSize="20" FontWeight="SemiBold" Foreground="#183345"/><TextBlock Text="Intro / Tab: siguiente" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#78909B" FontSize="11"/></DockPanel>
        <Border x:Name="MultiCurrencySummary" Grid.Row="1" Background="Transparent" Margin="0,0,0,8">
            <StackPanel>
                <UniformGrid x:Name="CurrencyCards" Columns="3"/>
                <TextBlock x:Name="CurrencyMetricsText" Visibility="Collapsed"/>
                <TextBlock x:Name="TotalCupText" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <Border x:Name="SingleCurrencySummary" Grid.Row="1" Background="#DCE9F7" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="SingleCurrencyLabel" Foreground="#42628D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock x:Name="SingleCurrencyTotalText" Foreground="#174A94" FontSize="18" FontWeight="Bold"/></StackPanel>
        </Border>
        <Grid Grid.Row="2"><TabControl x:Name="CurrenciesTabs" Visibility="Collapsed" Background="#F8FAFD" BorderThickness="0" ItemContainerStyle="{StaticResource CurrencyTab}"/>
            <ContentControl x:Name="SingleCurrencyHost" Visibility="Visible"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock x:Name="ExpectedText" Visibility="Collapsed"/><TextBlock x:Name="CurrencyTotalsText" Visibility="Collapsed"/><TextBlock x:Name="ErrorText" Foreground="#B44040" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Aceptar conteo" Style="{StaticResource PrimaryButton}" Click="Accept_Click"/></StackPanel>
    </Grid>
</Window>

