<Window x:Class="NexoCash.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:agencies="clr-namespace:NexoCash.Desktop.Features.Agencies"
        xmlns:services="clr-namespace:NexoCash.Desktop.Features.Services"
        xmlns:accounts="clr-namespace:NexoCash.Desktop.Features.Accounts"
        xmlns:movements="clr-namespace:NexoCash.Desktop.Features.Movements"
        xmlns:settings="clr-namespace:NexoCash.Desktop.Features.Settings"
        xmlns:workdays="clr-namespace:NexoCash.Desktop.Features.Workdays"
        xmlns:cash="clr-namespace:NexoCash.Desktop.Features.Cash"
        xmlns:exchange="clr-namespace:NexoCash.Desktop.Features.Exchange"
        xmlns:overview="clr-namespace:NexoCash.Desktop.Features.Overview"
        Title="NexoCash" Width="1280" Height="720" MinWidth="1280" MinHeight="720" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="#E1E8F0">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C6D5E2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#244777" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#142B50">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,27,16,25">
                    <TextBlock Text="NexoCash" Foreground="White" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Finanzas diarias" Foreground="#8FB0C3" FontSize="12" Margin="1,4,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NavigationButtons">
                    <TextBlock Text="ESPACIO DE TRABAJO" Foreground="#8FB0C3" Margin="24,8,0,8" FontSize="10"/>
                    <Button Style="{StaticResource NavButton}" Content="Resumen" Tag="Overview" Click="Navigation_Click" />
                    <Button Style="{StaticResource NavButton}" Content="Jornadas" Tag="Workdays" Click="Navigation_Click" />
                    <Button Style="{StaticResource NavButton}" Content="Servicios" Tag="Services" Click="Navigation_Click" />
                    <TextBlock Text="CONTACTOS" Foreground="#8FB0C3" Margin="24,16,0,8" FontSize="10"/>
                    <Button Style="{StaticResource NavButton}" Content="Agencias" Tag="Agencies" Click="Navigation_Click" />
                    <TextBlock Text="DINERO" Foreground="#8FB0C3" Margin="24,16,0,8" FontSize="10"/>
                    <Button Style="{StaticResource NavButton}" Content="Cuentas" Tag="Accounts" Click="Navigation_Click" />
                    <Button Style="{StaticResource NavButton}" Content="Movimientos" Tag="Movements" Click="Navigation_Click" />
                    <Button Style="{StaticResource NavButton}" Content="Efectivo" Tag="Cash" Click="Navigation_Click" />
                    <Button Style="{StaticResource NavButton}" Content="Cambio de divisas" Tag="Currency exchange" Click="Navigation_Click" />
                    <TextBlock Text="APLICACIÓN" Foreground="#8FB0C3" Margin="24,16,0,8" FontSize="10"/>
                    <Button Style="{StaticResource NavButton}" Content="Configuración" Tag="Settings" Click="Navigation_Click" />
                </StackPanel></ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                <TextBlock x:Name="SectionLabel" Text="ESPACIO DE TRABAJO" Foreground="#5B7382" FontSize="11" FontWeight="Bold" />
                <TextBlock x:Name="PageTitle" Text="Resumen" Foreground="#183345" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock x:Name="PageSubtitle" Text="Tu trabajo y dinero de un vistazo." Foreground="#5B7382" FontSize="14" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,-8">
                <StackPanel x:Name="HeaderActionsHost" Orientation="Horizontal" VerticalAlignment="Center"/>
                <StackPanel x:Name="CashActions" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="Recalcular cambios" Click="CashRecalculate_Click" Background="#DCE9F7" Foreground="#2868C7" BorderBrush="#91ADD0" Padding="17,10" Margin="0,0,10,0"/>
                    <Button Content="Contar toda la caja" Click="CashReconcile_Click" Background="#2868C7" Foreground="White" BorderThickness="0" Padding="17,10"/>
                </StackPanel>
                </StackPanel>
            </Grid>
            <Grid x:Name="ServiceTabsHost" Grid.Row="1" Panel.ZIndex="1" Margin="0,18,0,-1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            </Grid>
            <Border x:Name="AgenciesPanel" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,26,0,0" Visibility="Collapsed">
                <agencies:AgenciesView />
            </Border>
            <Border x:Name="ServicesPanel" Grid.Row="2" Background="#F8FAFD" CornerRadius="0,12,12,12" BorderBrush="#8FB1DB" BorderThickness="1" Padding="8" Margin="0" Visibility="Collapsed">
                <services:ServicesView x:Name="ServicesControl" />
            </Border>
            <Border x:Name="AccountsPanel" Grid.Row="2" Background="#F8FAFD" CornerRadius="14" BorderBrush="#8FB1DB" BorderThickness="1" Margin="0,26,0,0" Visibility="Collapsed">
                <accounts:AccountsView x:Name="AccountsControl" />
            </Border>
            <Border x:Name="MovementsPanel" Grid.Row="2" Background="#F8FAFD" CornerRadius="14" BorderBrush="#8FB1DB" BorderThickness="1" Margin="0,26,0,0" Visibility="Collapsed">
                <movements:MovementsView x:Name="MovementsControl" />
            </Border>
            <Border x:Name="SettingsPanel" Grid.Row="2" Background="#F8FAFD" CornerRadius="14" BorderBrush="#8FB1DB" BorderThickness="1" Margin="0,26,0,0" Visibility="Collapsed">
                <settings:CurrencySettingsView x:Name="SettingsControl" />
            </Border>
            <Border x:Name="WorkdaysPanel" Grid.Row="2" Background="#F8FAFD" CornerRadius="14" BorderBrush="#8FB1DB" BorderThickness="1" Margin="0,26,0,0" Visibility="Collapsed"><workdays:WorkdaysView x:Name="WorkdaysControl"/></Border>
            <Border x:Name="CashPanel" Grid.Row="2" Background="#F8FAFD" CornerRadius="14" BorderBrush="#8FB1DB" BorderThickness="1" Margin="0,26,0,0" Visibility="Collapsed"><cash:CashView x:Name="CashControl"/></Border>
            <Border x:Name="ExchangePanel" Grid.Row="2" Background="#F8FAFD" CornerRadius="14" BorderBrush="#8FB1DB" BorderThickness="1" Margin="0,26,0,0" Visibility="Collapsed"><exchange:ExchangeView x:Name="ExchangeControl"/></Border>
            <Border x:Name="OverviewPanel" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,26,0,0"><overview:OverviewView x:Name="OverviewControl"/></Border>
        </Grid>
    </Grid>
</Window>


